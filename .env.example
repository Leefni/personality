# Copy this file to .env (or set these as environment variables in your server runtime).
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personality
DB_USER=root
DB_PASS=

# Set to false in production to skip auto-schema bootstrap on every request.
DB_AUTO_BOOTSTRAP=true

# ── Application ───────────────────────────────────────────────────────────────
# Options: production | development | local
APP_ENV=production

# ── Test metadata (shown in the UI) ───────────────────────────────────────────
TEST_VERSION=2026.03
TEST_RELEASE_DATE=2026-03-18

# ── Data retention (cleanup_retention.php) ────────────────────────────────────
RETENTION_DAYS=90
RETENTION_MAX_DELETE_PER_TABLE=5000
# Set to true to report eligible rows without deleting them.
RETENTION_DRY_RUN=false

# ── Progress recovery emails ──────────────────────────────────────────────────
RECOVERY_TOKEN_TTL_SECONDS=900
RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
RECOVERY_RATE_LIMIT_MAX_PER_VISITOR=3
RECOVERY_RATE_LIMIT_MAX_PER_EMAIL=5
RECOVERY_EMAIL_FROM=no-reply@example.test
# Override the base URL used in recovery links (defaults to auto-detected from request).
RECOVERY_BASE_URL=
